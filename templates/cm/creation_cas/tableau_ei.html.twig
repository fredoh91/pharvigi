{# Tableau des effets indésirables #}

{# {% block stylesheets %}
    {{ encore_entry_link_tags('tableau_ei') }}
{% endblock %} #}

{% if lstEI is defined and lstEI is not empty %}
    <div class="table-responsive mt-4">
        {# <h4>Effets indésirables</h4> #}
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>libellé PT</th>
                </tr>
            </thead>
            <tbody>
                {% for ei in lstEI %}
                    <tr>
                        <td>{{ ei.PTTerme }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <div class="alert alert-info mt-4">
        Aucun effet indésirable associé à ce cas.
    </div>
{% endif %}