{# {% block stylesheets %}
    {{ encore_entry_link_tags('tableau_ei') }}
{% endblock %} #}

{% if lstStatutCasPV is defined and lstStatutCasPV is not empty %}
    <div class="table-responsive mt-4">
        {# <h4>Statuts du cas</h4> #}
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Statut</th>
                    <th>Date</th>
                    <th>Utilisateur</th>
                </tr>
            </thead>
            <tbody>
                {% for statut in lstStatutCasPV %}
                    <tr>
                        <td>{{ statut.LibStatut }}</td>
                        <td>{{ statut.DateMiseEnPlace ? statut.DateMiseEnPlace|date('d/m/Y') : 'Non définie' }}</td>
                        <td>{{ statut.UserCreate }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <div class="alert alert-info mt-4">
        Aucun statut associé à ce cas.
    </div>
{% endif %}