{% block stylesheets %}
    {{ encore_entry_link_tags('form_creation_cas_cm_donnees_principales') }}
{% endblock %}

{# Formulaire des données principales #}
<div class="form-container">
    
    <!-- Zone 1 : Dates, Numéros et CRPV -->
    <div class="area-date-cas">
        <div class="form-group">
            {{ form_label(form.dateArrivee, 'date d\'arrivée :') }}
            {{ form_widget(form.dateArrivee) }}
        </div>
        {% include 'cm/creation_cas/tableau_dates_csp.html.twig' %}
        <div class="form-group">
            {{ form_label(form.DateLimiteQualif_7jours, 'Date limite de qualif DMM :') }}
            {{ form_widget(form.DateLimiteQualif_7jours) }}
        </div>
    </div>
    
    <!-- Zone 1.5 : Identifiants -->
    <div class="area-id">
        {{ form_row(form.CRPV) }}
        {{ form_row(form.codeCRPV) }}
        {{ form_row(form.numeroBNPV) }}
    </div>

    <!-- Zone 2 : Infos Patient -->
    <div class="area-patient">
        <div class="form-group">
            {{ form_label(form.sexe, 'Sexe :') }}
            {{ form_widget(form.sexe) }}
        </div>
        <div class="form-group">
            {{ form_label(form.age, 'Âge :') }}
            {{ form_widget(form.age) }}
        </div>
        <div class="form-group">
            {{ form_label(form.uniteAge, 'Unité d\'âge :') }}
            {{ form_widget(form.uniteAge) }}
        </div>
    </div>

    <!-- Zone 3 : DME & Confirmation Médicale -->
    <div class="area-ei">
        <div class="form-group">
            {{ form_label(form.effetIndesirable, 'Effet indésirable :') }}
            {{ form_widget(form.effetIndesirable) }}
        </div>
        <div class="form-group">
            {# {{ form_label(form.FlConfirmMedicale, 'Confirmé médicalement :') }} #}
            {{ form_widget(form.FlConfirmMedicale) }}
        </div>
        {% include 'cm/creation_cas/tableau_ei.html.twig' %}
    </div>

    <!-- Zone 4 : Phase & Étapes (Workflow à droite) -->
    <div class="area-workflow">

    </div>

    <!-- Zone 4 : Phase & Étapes (Workflow à droite) -->
    <div class="area-on-verra-plus-tard">
        <div class="form-group">
            {{ form_label(form.finalise, 'Finalisé :') }}
            {{ form_widget(form.finalise) }}
        </div>
        <div class="form-group">
            {{ form_label(form.MotifNonPresentation, 'Motif de non-présentation :') }}
            {{ form_widget(form.MotifNonPresentation) }}
        </div>
    </div>

    <!-- Zone 4.3 : typologie du cas -->
    <div class="area-typology">
        <div class="form-group">
            {{ form_label(form.TypeCasPV, 'Type de cas :') }}
            {{ form_widget(form.TypeCasPV) }}
        </div>
        <div class="form-group">
            {{ form_label(form.lettre, 'Lettre :') }}
            {{ form_widget(form.lettre) }}
        </div>
        <div class="form-group">
            {{ form_label(form.typologie, 'Typologie :') }}
            {{ form_widget(form.typologie) }}
        </div>
        <div>
            Utilisateur de création du cas : 
            {% if userCreateObject is not null %}
                {{ userCreateObject.prenom }} {{ userCreateObject.nom }}
            {% else %}
                <p>Aucun utilisateur de création trouvé.</p>
            {% endif %}
        </div>    
    </div>


    <!-- Zone 4.5 : Produits -->
    <div class="area-produits">
        {% include 'cm/creation_cas/tableau_produits.html.twig' %}
    </div>

    <!-- Zone 5 : Métadonnées Problématique -->
    <div class="area-problematique">
        {{ form_row(form.problematique) }}
    </div>

    <!-- Zone 6 : Zone de Texte Présentation -->
    {# <div class="area-presentation-text">
        {{ form_row(form.presentation) }}
    </div> #}

    <!-- Zone 7 : Proposition & Avis CRPV -->
    <div class="area-crpv">
        {{ form_label(form.propositionCRPV, 'Proposition CRPV :') }}
        {{ form_label(form.avisCRPV, 'Avis CRPV :') }}
        {{ form_widget(form.avisCRPV) }}
        {{ form_widget(form.propositionCRPV) }}
    </div>
    <!-- Zone 12 : Pré-qualification DSURV -->
    <div class="area-dsurv">
        {{ form_label(form.motifPrequalification, 'Motif de pré-qualification :') }}
        {{ form_label(form.prequalificationDSURV, 'Pré-qualification DSURV :') }}
        {{ form_widget(form.prequalificationDSURV) }}
        {{ form_widget(form.motifPrequalification) }}
    </div>

    <!-- Zone 14 : Autres informations (S'adaptent en bas) -->
    <div class="area-dmm">
        {{ form_row(form.motifQualificationDMM) }}
        {{ form_row(form.investigationDMM) }}
        {{ form_row(form.echangeDMM_CRPV) }}
    </div>

    <!-- Zone 8 : Cluster -->
    <div class="area-cluster-checkbox">
        {{ form_row(form.cluster) }}
    </div>


    <!-- Zone 10 : Bloc Gravité et Critères -->
    <div class="area-gravite-group">
        {{ form_row(form.gravite) }}
        {{ form_row(form.deces) }}
        {{ form_row(form.miseEnJeuPronostic) }}
        {{ form_row(form.hospitalisation) }}
        {{ form_row(form.incapacite) }}
        {{ form_row(form.anomalieCongenitale) }}
        {{ form_row(form.autreSituation) }}
    </div>

    <!-- Zone 11 : Évaluateurs & Suivi -->
    {# <div class="area-evaluators"> #}
        {# {{ form_row(form.suiviEnquete) }} #}
        {# {{ form_row(form.ListeCRPV) }} #}
    {# </div> #}


    <!-- Zone 13 : Chronologie & Risque Final -->
    <div class="area-niv-risk">
        <div class="form-group">
            {{ form_label(form.niveauRisquePGS, 'Niveau de risque PGS :') }}
            {{ form_widget(form.niveauRisquePGS) }}
        </div>
        <div class="form-group">
            {{ form_label(form.niveauRisqueFinal, 'Niveau de risque final :') }}
            {{ form_widget(form.niveauRisqueFinal) }}
        </div>
        <div class="form-group">
            {{ form_label(form.MaitriseRisque_Commentaire, 'Commentaire sur la maîtrise du risque :') }}
            {{ form_widget(form.MaitriseRisque_Commentaire) }}
        </div>
        <div class="form-group">
            {{ form_label(form.SRE, 'SRE :') }}
            {{ form_widget(form.SRE) }}
        </div>
    </div>


</div>