{# Tableau des produits lié au cas #}
{% if lstProduitsCasPV is defined %}
    <div class="table-responsive mt-4">
        <h4>Produits associés</h4>
        <div class="d-flex justify-content-center mb-3">
            <a href="{{ path('app_creation_produits', { type_cas_pv: 'CM', idCasPV: cas.id, routeSource: 'app_cm_creation_cas_creation' }) }}" class="btn btn-primary">Gestion des produits</a>
        </div>
        {% if lstProduitsCasPV is not empty %}
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Spécialité</th>
                        <th>DCI</th>
                        <th>Dosage</th>
                        <th>CodeATC</th>
                        <th>CodeCIS</th>
                        <th>Type Proc.</th>
                        <th>Modif.</th>
                        <th>Supp.</th>
                    </tr>
                </thead>
                <tbody>
                    {% for produit in lstProduitsCasPV %}
                        <tr>
                            <td>{{ produit.Denomination }}</td>
                            <td>{{ produit.DCI }}</td>
                            <td>{{ produit.Dosage }}</td>
                            <td>{{ produit.CodeATC }}</td>
                            <td>{{ produit.CodeCIS }}</td>
                            <td>{{ produit.TypeProcedure }}</td>
                            <td><button class="btn btn-sm btn-outline-primary">Modifier</button></td>
                            <td><button class="btn btn-sm btn-outline-danger">Supprimer</button></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div class="alert alert-info mt-4">
                Aucun produit associé à ce cas.
            </div>
        {% endif %}
    </div>
{% endif %}
