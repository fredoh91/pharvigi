{# Tableau des produits lié au cas #}
{% if lstProduitsCasPV is defined %}
    <div class="table-responsive mt-4">
        <h4>Produits associés</h4>
        <div class="d-flex justify-content-center mb-3">
        {% if is_granted('ROLE_PHARVIGI_SURV_GEST') or is_granted('ROLE_PHARVIGI_SURV_EVAL') %}
            <a
                href="{{ path('app_creation_produits', {
                    'type_cas_pv': cas.TypeCasPV,
                    'idCasPV': cas.id,
                    'routeSource': routeSource ?? null
                }) }}"
                class="btn btn-primary"
            >
                Gestion des produits
            </a>
        {% endif %}
        </div>
        {% if lstProduitsCasPV is not empty %}
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Spécialité</th>
                        <th>DCI</th>
                        <th>Dosage</th>
                        <th>CodeATC</th>
                        <th>CodeCIS</th>
                        <th>Type Proc.</th>
                        {% if is_granted('ROLE_PHARVIGI_SURV_GEST') or is_granted('ROLE_PHARVIGI_SURV_EVAL') %}
                            <th>Modif.</th>
                        {% endif %}

                        {% if is_granted('ROLE_PHARVIGI_SURV_ADMIN') %}
                            <th>Supp.</th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for produit in lstProduitsCasPV %}
                        <tr>
                            <td>{{ produit.Denomination }}</td>
                            <td>{{ produit.DCI }}</td>
                            <td>{{ produit.Dosage }}</td>
                            <td>{{ produit.CodeATC }}</td>
                            <td>{{ produit.CodeCIS }}</td>
                            <td>{{ produit.TypeProcedure }}</td>
                            {% if is_granted('ROLE_PHARVIGI_SURV_GEST') or is_granted('ROLE_PHARVIGI_SURV_EVAL') %}
                                <td>
                                    <a 
                                        href="{{ path('app_modif_produits', {
                                            'type_cas_pv': cas.TypeCasPV,
                                            'idCasPV': cas.id,
                                            'produitId': produit.Id,
                                            'routeSource': routeSource ?? null
                                        }) }}"
                                        class="btn btn-sm btn-outline-primary"
                                    >
                                        Modifier
                                    </a>
                                </td>
                            {% endif %}
                            {% if is_granted('ROLE_PHARVIGI_SURV_ADMIN') %}
                                <td>
                                    <a
                                        href="{{ path('app_suppression_produits', {
                                            'type_cas_pv': cas.TypeCasPV,
                                            'idCasPV': cas.id,
                                            'produitId': produit.Id,
                                            'routeSource': routeSource ?? null
                                        }) }}"
                                        class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce produit ?');"
                                    >
                                        Supprimer
                                    </a>
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div class="alert alert-info mt-4">
                Aucun produit associé à ce cas.
            </div>
        {% endif %}
    </div>
{% endif %}